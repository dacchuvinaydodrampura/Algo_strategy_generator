# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHANNEL_ID=-1001234567890

# Storage paths (override defaults)
DATA_ROOT=/opt/market_research/data

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Backtest cost assumptions
BROKERAGE_PER_LOT=20.0
SLIPPAGE_TICKS=1
LATENCY_MS=50

# Pattern discovery thresholds
MIN_PATTERN_SAMPLES=30
MIN_WIN_RATE=0.52
MIN_PROFIT_FACTOR=1.3

# Processing
CHUNK_SIZE_TICKS=5000
MAX_WORKERS=2
